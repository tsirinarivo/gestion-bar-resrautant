generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/master-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

// ─── TENANTS (clients du SaaS) ─────────────────────────────────────────────

model Tenant {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  contactName  String?
  contactEmail String
  contactPhone String?
  status       TenantStatus @default(PROVISIONING)

  // Infra (auto-allouée)
  dbName     String @unique
  apiPort    Int    @unique
  webPort    Int    @unique
  posPort    Int    @unique
  kdsPort    Int    @unique
  clientPort Int    @unique

  // Domaines
  subdomain   String  @unique // "pierre" → pierre.sakafio.mg
  customDomain String? @unique // sprint 3+

  // Sécurité
  dbPassword       String // password Postgres dédié au tenant (random)
  jwtSecret        String // JWT secret dédié (rotation possible)
  jwtRefreshSecret String
  apiCrossSecret   String // partagé avec la master pour "login as"

  // Provisioning timeline
  provisionedAt  DateTime?
  lastDeployedAt DateTime?
  suspendedAt    DateTime?
  suspendReason  String?

  // Subscription / trial — self-service signup depuis sakafio.mg/signup
  signupSource       String?   // 'self-service', 'manual-master', 'imported'
  seededWithDemo     Boolean   @default(false) // données démo (mofo gasy, etc.) pré-remplies
  trialEndsAt        DateTime? // null = pas de trial / déjà payant
  subscriptionPlan   String?   // 'trial', 'starter', 'pro', 'enterprise'
  subscriptionStatus String?   // 'TRIAL', 'ACTIVE', 'PAST_DUE', 'CANCELED'
  trialExpiredNoticeSentAt DateTime?  // pour ne pas spammer le mail J-1

  // Notes admin
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription?
  invoices     Invoice[]
  events       TenantEvent[]
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
  ERROR
}

// ─── UTILISATEURS DE LA MASTER (toi + support) ─────────────────────────────

model MasterUser {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  role      MasterRole @default(SUPPORT)
  active    Boolean    @default(true)
  lastLogin DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  events TenantEvent[]
}

enum MasterRole {
  OWNER
  SUPPORT
}

// ─── ABONNEMENTS (sprint 2) ────────────────────────────────────────────────

model Subscription {
  id          String             @id @default(cuid())
  tenantId    String             @unique
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        String             @default("basic")
  amountMga   Int                @default(0)
  status      SubscriptionStatus @default(ACTIVE)
  startedAt   DateTime           @default(now())
  nextDueDate DateTime
  canceledAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Invoice {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number     String        @unique
  amountMga  Int
  status     InvoiceStatus @default(PENDING)
  periodFrom DateTime
  periodTo   DateTime
  dueDate    DateTime
  paidAt     DateTime?
  paidMethod String?
  notes      String?
  createdAt  DateTime      @default(now())
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

// ─── PLANS D'ABONNEMENT (catalogue, sprint MT-2) ───────────────────────────
// Subscription.plan référence Plan.key (string libre, pas de FK pour rester
// flexible si un plan est supprimé alors que des tenants l'utilisent encore).
model Plan {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  amountMga Int      @default(0)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── AUDIT TRAIL (qui a fait quoi sur un tenant) ───────────────────────────

model TenantEvent {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String?
  user     MasterUser? @relation(fields: [userId], references: [id])
  type     String      // PROVISIONED, SUSPENDED, REACTIVATED, LOGIN_AS, INVOICE_PAID, etc.
  details  String?
  createdAt DateTime  @default(now())

  @@index([tenantId, createdAt])
}

// ─── CONFIG MASTER (paramètres globaux : SMTP, branding, etc.) ─────────────
// Key-value pour rester flexible. Une row par clé, value en JSON pour les
// configs structurées (ex: { host, port, user, pass, from } pour SMTP).
model MasterSetting {
  key       String   @id        // 'smtp', 'branding', etc.
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?              // userId du MasterUser qui a modifié
}

// ─── DÉPLOIEMENTS (bash deploy/update.sh lancé depuis l'UI) ────────────────
// Trace chaque exécution du script de mise à jour avec son log live (append).
model UpdateRun {
  id          String    @id @default(cuid())
  status      String    @default("RUNNING") // RUNNING, SUCCESS, FAILED
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  startedBy   String?   // userId du MasterUser qui a déclenché
  log         String    @default("") // stdout + stderr append au fur et à mesure
  exitCode    Int?

  @@index([startedAt(sort: Desc)])
}
