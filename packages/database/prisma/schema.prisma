generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── RESTAURANT ───────────────────────────────────────────────────────────────

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  banner      String?
  address     String
  city        String
  postalCode  String
  country     String   @default("FR")
  phone       String
  email       String
  siret       String?
  website     String?
  timezone    String   @default("Indian/Antananarivo")
  currency    String   @default("MGA")
  vatNumber   String?

  // Opening hours stored as JSON
  openingHours Json?

  // Settings
  defaultTaxRate    Float  @default(10)
  deliveryEnabled   Boolean @default(true)
  pickupEnabled     Boolean @default(true)
  dineInEnabled     Boolean @default(true)
  minOrderAmount    Float   @default(0)
  deliveryRadius    Float?
  deliveryFee       Float   @default(0)
  estimatedPrepTime Int     @default(20) // minutes

  // Autorise la vente d'un produit même à stock épuisé (le stock devient
  // négatif et se régularise au prochain réapprovisionnement).
  allowNegativeStock Boolean @default(false)

  // En-tête / pied de page personnalisés pour les factures imprimées
  // (mentions légales NIF/STAT, slogan, message de remerciement…).
  invoiceHeader String?
  invoiceFooter String?

  // Code PIN (hashé bcrypt) exigé pour modifier une commande déjà envoyée
  // (correction d'erreur de saisie au POS). Null = aucune restriction.
  modificationPin String?

  // ── Personnalisation du site vitrine client (<slug>.sakafio.mg) ──
  siteTemplate    String  @default("classic") // classic | modern | compact
  sitePrimaryColor String? // couleur d'accent hex (ex. #F97316)
  siteTagline     String?  // slogan affiché sous le titre
  siteHeroImage   String?  // image d'accueil (URL)

  // Monthly revenue target
  monthlyRevenueTarget Float?

  // Stripe
  stripeAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  categories    Category[]
  products      Product[]
  tables        DiningTable[]
  orders        Order[]
  reservations  Reservation[]
  employees     Employee[]
  customers     Customer[]
  promotions    Promotion[]
  campaigns     Campaign[]
  stockItems    StockItem[]
  suppliers     Supplier[]
  notifications Notification[]
  auditLogs     AuditLog[]
  waitingLists  WaitingList[]
  coupons       Coupon[]
  reviews       Review[]
  expenses      Expense[]
  warehouses     Warehouse[]
  stockTransfers StockTransfer[]
  caisseSessions CaisseSession[]
  bankAccounts   BankAccount[]
  posTerminals   PosTerminal[]
  customerDebts  CustomerDebt[]

  @@map("restaurants")
}

// ─── AUTH & USERS ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  avatar       String?
  phone        String?
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  lastLoginAt  DateTime?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]
  employee      Employee?
  auditLogs     AuditLog[]
  posTerminals  PosTerminalUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── MENU ─────────────────────────────────────────────────────────────────────

model Category {
  id           String  @id @default(cuid())
  name         String
  slug         String
  description  String?
  icon         String?
  color        String?
  image        String?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  isAvailable  Boolean @default(true)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@map("categories")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  shortDesc   String?
  sku         String?
  barcode     String?

  // Pricing
  price           Float
  comparePrice    Float?
  costPrice       Float?
  taxRate         Float  @default(10)

  // Media
  image           String?
  images          String[]

  // Status
  isActive        Boolean @default(true)
  isAvailable     Boolean @default(true)
  isFeatured      Boolean @default(false)
  isNew           Boolean @default(false)
  sortOrder       Int     @default(0)

  // Soft delete : OrderItem.productId est en Restrict (FK) donc on ne peut
  // pas hard-supprimer un produit qui a déjà été vendu. Le DELETE API ci-
  // dessous set deletedAt + filtre les listings (au lieu de prisma.delete()).
  deletedAt       DateTime?

  // Nutritional info
  calories        Int?
  proteins        Float?
  carbs           Float?
  fats            Float?
  fiber           Float?

  // Allergens (14 official EU allergens)
  allergens       String[]

  // KDS station assignment (hot, cold, drinks, desserts)
  kdsStation      String?

  // Tags
  tags            String[]

  // Availability schedule (JSON: {monday: {start: "10:00", end: "22:00"}, ...})
  availabilitySchedule Json?

  // Prep time in minutes
  prepTime        Int     @default(10)

  // No kitchen required (bottled drinks, packaged items)
  requiresPreparation Boolean @default(true)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Entrepôt auquel ce produit appartient (null = disponible sur tous les terminaux)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // Article de stock directement lié à ce produit (produits vendus tels quels, sans recette)
  stockItemId String?
  stockItem   StockItem? @relation("ProductDirectStock", fields: [stockItemId], references: [id], onDelete: SetNull)

  variants       ProductVariant[]
  modifierGroups ProductModifierGroup[]
  recipeItems    RecipeItem[]
  orderItems     OrderItem[]
  promotionItems PromotionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([warehouseId])
  @@index([stockItemId])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String
  sku       String?
  price     Float
  costPrice Float?
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItemVariants OrderItemModifier[]

  @@index([productId])
  @@map("product_variants")
}

model ModifierGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  minSelect   Int     @default(0)
  maxSelect   Int     @default(1)
  isRequired  Boolean @default(false)
  sortOrder   Int     @default(0)

  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@map("modifier_groups")
}

model Modifier {
  id        String  @id @default(cuid())
  name      String
  price     Float   @default(0)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
  @@map("modifiers")
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String
  sortOrder       Int    @default(0)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

// ─── INGREDIENTS & RECIPES ────────────────────────────────────────────────────

model Ingredient {
  id          String  @id @default(cuid())
  name        String
  description String?
  unit        String  // kg, g, L, cl, unit, portion
  costPerUnit Float   @default(0)

  // Nutritional per 100g
  calories    Float?
  proteins    Float?
  carbs       Float?
  fats        Float?

  allergens   String[]

  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])

  recipeItems RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ingredients")
}

model RecipeItem {
  id         String @id @default(cuid())
  quantity   Float
  unit       String
  yieldRate  Float  @default(1.0) // cooking yield (e.g. 0.85 for 15% loss)
  notes      String?

  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
  @@map("recipe_items")
}

// ─── STOCK ────────────────────────────────────────────────────────────────────

model StockItem {
  id              String  @id @default(cuid())
  name            String
  description     String?
  sku             String?
  barcode         String?
  unit            String
  currentQuantity Float   @default(0)
  minQuantity     Float   @default(0) // alert threshold
  reorderQuantity Float   @default(0) // auto-order threshold
  maxQuantity     Float?
  location        String? // kitchen, bar, cold storage, reserve

  costPerUnit     Float   @default(0)
  valuationMethod String  @default("FIFO") // FIFO, CMUP

  isPerishable    Boolean @default(false)
  expiryDate      DateTime?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  movements       StockMovement[]
  alerts          StockAlert[]
  purchaseItems   PurchaseOrderItem[]
  ingredients     Ingredient[]
  stockBatches    StockBatch[]
  supplierPrices  StockItemSupplier[]
  transferItems   StockTransferItem[]
  levels          StockLevel[]
  products        Product[] @relation("ProductDirectStock")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@map("stock_items")
}

model StockItemSupplier {
  id            String  @id @default(cuid())
  unitCost      Float
  referenceCode String?
  isPreferred   Boolean @default(false)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([stockItemId, supplierId])
  @@index([stockItemId])
  @@map("stock_item_suppliers")
}

model StockBatch {
  id           String   @id @default(cuid())
  batchNumber  String?
  quantity     Float
  remainingQty Float
  costPerUnit  Float
  expiryDate   DateTime?
  receivedAt   DateTime @default(now())

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
  @@map("stock_batches")
}

model StockMovement {
  id        String   @id @default(cuid())
  type      String   // IN, OUT, ADJUSTMENT, LOSS, TRANSFER
  quantity  Float
  unitCost  Float?
  reason    String?
  notes     String?
  reference String?  // order ID, purchase order ID, etc.

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  warehouseId String?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([stockItemId])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockLevel {
  id          String   @id @default(cuid())
  quantity    Float    @default(0)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stockItemId, warehouseId])
  @@index([stockItemId])
  @@index([warehouseId])
  @@map("stock_levels")
}

model StockAlert {
  id        String   @id @default(cuid())
  type      String   // LOW_STOCK, OUT_OF_STOCK, EXPIRY_SOON, EXPIRED
  message   String
  isRead    Boolean  @default(false)
  resolvedAt DateTime?

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([stockItemId])
  @@index([isRead, createdAt])
  @@map("stock_alerts")
}

model Warehouse {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  location     String?
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockItems    StockItem[]
  stockLevels   StockLevel[]
  products      Product[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  posTerminals  PosTerminal[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("warehouses")
}

model StockTransfer {
  id              String              @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reference       String?
  fromWarehouseId String
  toWarehouseId   String
  status          String              @default("PENDING") // PENDING, IN_TRANSIT, COMPLETED, CANCELLED
  notes           String?
  completedAt     DateTime?
  createdBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@index([restaurantId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id           String        @id @default(cuid())
  transferId   String
  stockItemId  String
  quantity     Float
  unitCost     Float?
  notes        String?

  transfer  StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  stockItem StockItem     @relation(fields: [stockItemId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

model Supplier {
  id            String  @id @default(cuid())
  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?
  city          String?
  postalCode    String?
  country       String  @default("FR")
  siret         String?
  paymentTerms  String?
  deliveryDays  String[] // ["monday", "wednesday", "friday"]
  leadTimeDays  Int     @default(2)
  notes         String?
  isActive      Boolean @default(true)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  stockItems     StockItem[]
  purchaseOrders PurchaseOrder[]
  itemPrices     StockItemSupplier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  orderNumber  String   @unique
  status       String   @default("DRAFT") // DRAFT, SENT, CONFIRMED, RECEIVED, CANCELLED
  notes        String?
  totalAmount  Float    @default(0)
  orderedAt    DateTime?
  expectedAt   DateTime?
  receivedAt   DateTime?

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // Entrepôt de destination à la réception (défaut = entrepôt par défaut).
  warehouseId String?

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  quantity        Float
  unitCost        Float
  receivedQuantity Float  @default(0)
  notes           String?
  // Entrepôt de réception de cette ligne (défaut = celui du bon de commande).
  warehouseId     String?

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ─── TABLES & RESERVATIONS ────────────────────────────────────────────────────

model DiningTable {
  id           String  @id @default(cuid())
  number       Int
  name         String?
  capacity     Int
  minCapacity  Int     @default(1)
  shape        String  @default("rectangle") // rectangle, circle, square
  width        Float   @default(100) // pixels for floor plan
  height       Float   @default(80)
  posX         Float   @default(0) // floor plan position
  posY         Float   @default(0)
  rotation     Float   @default(0)
  section      String? // terrace, salle principale, bar
  status       String  @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, CLEANING, BLOCKED
  isActive     Boolean @default(true)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orders       Order[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("dining_tables")
}

model Reservation {
  id             String   @id @default(cuid())
  reservationRef String   @unique
  firstName      String
  lastName       String
  email          String?
  phone          String?
  partySize      Int
  date           DateTime
  duration       Int      @default(90) // minutes
  status         String   @default("PENDING") // PENDING, CONFIRMED, SEATED, COMPLETED, CANCELLED, NO_SHOW
  notes          String?
  specialRequest String?
  source         String   @default("ONLINE") // ONLINE, PHONE, WALK_IN, GOOGLE

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId String?
  table   DiningTable? @relation(fields: [tableId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  reminders ReservationReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([date])
  @@index([customerId])
  @@index([tableId, date])
  @@map("reservations")
}

model ReservationReminder {
  id            String   @id @default(cuid())
  type          String   // EMAIL, SMS
  scheduledAt   DateTime
  sentAt        DateTime?
  status        String   @default("PENDING")

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_reminders")
}

model WaitingList {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  phone      String
  email      String?
  partySize  Int
  notifiedAt DateTime?
  status     String   @default("WAITING") // WAITING, NOTIFIED, SEATED, LEFT

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@map("waiting_list")
}

// ─── ORDERS ───────────────────────────────────────────────────────────────────

model Order {
  id           String   @id @default(cuid())
  orderNumber  String   @unique
  type         String   // DINE_IN, TAKEAWAY, DELIVERY, ONLINE
  status       String   @default("PENDING") // PENDING, CONFIRMED, PREPARING, READY, DELIVERED, COMPLETED, CANCELLED
  source       String   @default("POS") // POS, ONLINE, KIOSK, PHONE

  // Pricing
  subtotal     Float    @default(0)
  taxAmount    Float    @default(0)
  discountAmount Float  @default(0)
  deliveryFee  Float    @default(0)
  tipAmount    Float    @default(0)
  totalAmount  Float    @default(0)

  // Customer info for delivery
  deliveryAddress  String?
  deliveryCity     String?
  deliveryPostalCode String?
  deliveryNotes    String?

  // Timing
  estimatedTime    Int?      // minutes
  confirmedAt      DateTime?
  preparedAt       DateTime?
  readyAt          DateTime?
  deliveredAt      DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancellationReason String?

  notes          String?
  guestCount     Int     @default(1)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId String?
  table   DiningTable? @relation(fields: [tableId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  items          OrderItem[]
  payments       Payment[]
  statusHistory  OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
  @@index([tableId])
  @@index([customerId])
  // Indexes composites pour les queries hot (dashboard, KDS, finances, list)
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String @id @default(cuid())
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  // Snapshot du nom du produit au moment de la commande. Évite que renommer
  // un produit modifie l'affichage des factures historiques (= falsification).
  // Nullable pour rétro-compatibilité ; backfill via script puis NOT NULL.
  productName  String?
  notes        String?
  status       String @default("PENDING") // PENDING, PREPARING, READY, SERVED, CANCELLED
  kdsStation   String? // hot, cold, drinks, desserts
  preparedAt   DateTime?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // productId nullable : articles "externes" hors menu/hors stock, achetés à la
  // demande chez un confrère et revendus. Identifiés par productName + costPrice.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // Coût d'achat d'un article externe (ce qu'on a payé) → marge = unitPrice - costPrice.
  costPrice Float?

  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemModifier {
  id         String @id @default(cuid())
  name       String
  price      Float  @default(0)
  type       String // MODIFIER, VARIANT

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  modifierId String?
  modifier   Modifier? @relation(fields: [modifierId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  status  String
  notes   String?
  changedBy String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

model Payment {
  id              String   @id @default(cuid())
  amount          Float
  currency        String   @default("MGA")
  method          String   // CASH, CARD, STRIPE, PAYPAL, VOUCHER, WALLET
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED, PARTIAL_REFUND
  reference       String?  // Stripe payment intent ID
  stripePaymentId String?
  receiptUrl      String?
  notes           String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  refunds  Refund[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id        String @id @default(cuid())
  amount    Float
  reason    String?
  status    String @default("PENDING") // PENDING, COMPLETED, FAILED
  stripeRefundId String?
  notes     String?

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refunds")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  issueDate     DateTime @default(now())
  dueDate       DateTime?
  totalHT       Float
  totalTax      Float
  totalTTC      Float
  status        String   @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  pdfUrl        String?
  notes         String?

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  items InvoiceItem[]

  createdAt DateTime @default(now())

  @@map("invoices")
}

model InvoiceItem {
  id          String @id @default(cuid())
  description String
  quantity    Int
  unitPrice   Float
  taxRate     Float
  totalHT     Float
  totalTTC    Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ─── CUSTOMERS ────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  firstName String
  lastName  String
  birthDate DateTime?
  avatar    String?
  isActive  Boolean  @default(true)

  // Address
  address    String?
  city       String?
  postalCode String?
  country    String  @default("FR")

  // Marketing
  acceptsMarketing Boolean @default(false)
  acceptsSms       Boolean @default(false)
  source           String  @default("ONLINE") // ONLINE, POS, IMPORT

  // Internal notes (allergies, preferences) — staff only
  notes String?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orders       Order[]
  reservations Reservation[]
  loyaltyAccount LoyaltyAccount?
  reviews      Review[]
  addresses    CustomerAddress[]
  couponUsages CouponUsage[]
  debts        CustomerDebt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([email])
  @@map("customers")
}

model CustomerAddress {
  id         String  @id @default(cuid())
  label      String  @default("home") // home, work, other
  address    String
  city       String
  postalCode String
  country    String  @default("FR")
  isDefault  Boolean @default(false)
  lat        Float?
  lng        Float?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model LoyaltyAccount {
  id           String @id @default(cuid())
  points       Int    @default(0)
  totalEarned  Int    @default(0)
  totalSpent   Int    @default(0)
  tier         String @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  tierExpiry   DateTime?

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  transactions LoyaltyTransaction[]

  updatedAt DateTime @updatedAt

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String @id @default(cuid())
  type        String // EARN, SPEND, EXPIRE, ADJUSTMENT
  points      Int
  balance     Int
  description String?
  reference   String?

  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([accountId])
  @@map("loyalty_transactions")
}

// ─── EMPLOYEES ────────────────────────────────────────────────────────────────

model Employee {
  id           String  @id @default(cuid())
  employeeCode String?
  position     String
  department   String?
  hireDate     DateTime?
  endDate      DateTime?
  salary       Float?
  salaryType   String  @default("HOURLY") // HOURLY, MONTHLY
  pin          String? // 4-digit PIN for clock-in
  qrCode       String? @unique
  isActive     Boolean @default(true)
  bankAccount  String?
  notes        String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  shifts     ScheduleShift[]
  timeEntries TimeEntry[]
  leaves     Leave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@map("employees")
}

model ScheduleShift {
  id         String   @id @default(cuid())
  date       DateTime
  startTime  String   // HH:mm
  endTime    String
  breakTime  Int      @default(0) // minutes
  station    String?
  notes      String?
  isPublished Boolean @default(false)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([date])
  @@map("schedule_shifts")
}

model TimeEntry {
  id          String   @id @default(cuid())
  date        DateTime
  clockIn     DateTime
  clockOut    DateTime?
  breakStart  DateTime?
  breakEnd    DateTime?
  totalHours  Float?
  overtimeHours Float?
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, ADJUSTED
  notes       String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@map("time_entries")
}

model Leave {
  id        String   @id @default(cuid())
  type      String   // VACATION, SICK, PERSONAL, UNPAID, PUBLIC_HOLIDAY
  startDate DateTime
  endDate   DateTime
  days      Float
  reason    String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedBy String?
  approvedAt DateTime?
  notes     String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@map("leaves")
}

// ─── PROMOTIONS & MARKETING ───────────────────────────────────────────────────

model Promotion {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   // PERCENTAGE, FIXED_AMOUNT, BUY_X_GET_Y, FREE_DELIVERY
  value       Float
  minOrderAmount Float?
  maxDiscount Float?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  usageLimit  Int?
  usageCount  Int      @default(0)
  channels    String[] // ONLINE, POS, BOTH

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  products    PromotionProduct[]
  categories  PromotionCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

model PromotionCategory {
  promotionId String
  categoryId  String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@map("promotion_categories")
}

model Coupon {
  id           String   @id @default(cuid())
  code         String   // unicité composite via @@unique([restaurantId, code]) ci-dessous
  description  String?
  type         String   // PERCENTAGE, FIXED_AMOUNT, FREE_DELIVERY
  value        Float
  minOrderAmount Float?
  maxDiscount  Float?
  startDate    DateTime?
  endDate      DateTime?
  usageLimit   Int?
  usagePerUser Int      @default(1)
  usageCount   Int      @default(0)
  isActive     Boolean  @default(true)
  channels     String[]

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orders Order[]
  usages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@unique([restaurantId, code])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  usedAt   DateTime @default(now())
  discount Float

  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([couponId])
  @@index([customerId])
  @@index([couponId, customerId])
  @@map("coupon_usages")
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  type        String   // EMAIL, SMS, PUSH
  subject     String?
  content     String
  status      String   @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, CANCELLED
  scheduledAt DateTime?
  sentAt      DateTime?
  recipientCount Int   @default(0)
  openCount   Int      @default(0)
  clickCount  Int      @default(0)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaigns")
}

// ─── REVIEWS ──────────────────────────────────────────────────────────────────

model Review {
  id         String @id @default(cuid())
  rating     Int    // 1-5
  title      String?
  content    String?
  reply      String?
  repliedAt  DateTime?
  isVerified Boolean @default(false)
  isPublic   Boolean @default(true)
  orderId    String?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@map("reviews")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  type      String   // ORDER, STOCK, RESERVATION, EMPLOYEE, SYSTEM
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  targetRole String? // which role to notify

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  recipientId String?

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@index([isRead])
  @@map("notifications")
}

// ─── FINANCES ─────────────────────────────────────────────────────────────────

enum ExpenseCategory {
  PERSONNEL
  LOYER
  ENERGIE
  FOURNITURES
  MARKETING
  MAINTENANCE
  AUTRE
}

model Expense {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     ExpenseCategory
  amount       Float
  date         DateTime
  description  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([restaurantId, date])
  @@map("expenses")
}

// ─── CAISSE & BANQUE ──────────────────────────────────────────────────────────

model CaisseSession {
  id            String    @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  terminalId    String?
  terminal      PosTerminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  status        String    @default("OPEN")   // OPEN, CLOSED
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  openedById    String?
  closedById    String?
  openingFloat  Float     @default(0)
  expectedCash  Float     @default(0)
  closingFloat  Float?
  difference    Float?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactions CaisseTransaction[]

  @@index([restaurantId, status])
  @@index([restaurantId, openedAt])
  @@index([terminalId])
  @@map("caisse_sessions")
}

model CaisseTransaction {
  id           String   @id @default(cuid())
  sessionId    String
  restaurantId String
  type         String   // SALE, REFUND, EXPENSE, DEPOSIT, WITHDRAWAL, ADJUSTMENT
  amount       Float
  description  String?
  reference    String?
  createdAt    DateTime @default(now())

  session CaisseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([restaurantId, createdAt])
  @@map("caisse_transactions")
}

model BankAccount {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  bankName      String?
  accountNumber String?
  type          String   @default("CHECKING") // CHECKING, SAVINGS
  balance       Float    @default(0)
  currency      String   @default("MGA")
  isActive      Boolean  @default(true)
  paymentMethod String?  // CASH, CARD, STRIPE, PAYPAL, VOUCHER, WALLET — auto-wires payments
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions BankTransaction[]

  @@unique([restaurantId, paymentMethod])
  @@index([restaurantId])
  @@map("bank_accounts")
}

model BankTransaction {
  id           String   @id @default(cuid())
  accountId    String
  restaurantId String
  type         String   // CREDIT, DEBIT
  amount       Float
  balanceAfter Float
  description  String?
  reference    String?
  date         DateTime @default(now())
  reconciled   Boolean  @default(false)
  createdAt    DateTime @default(now())

  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([restaurantId, date])
  @@map("bank_transactions")
}

// ─── IMPRIMANTE THERMIQUE ─────────────────────────────────────────────────────

enum PrintLogStatus {
  pending
  printed
  failed
}

model PrinterConfig {
  id        String  @id @default(cuid())
  ownerId   String  @unique
  enabled   Boolean @default(false)
  user      String?
  key       String?
  region    String  @default("cn")
  sn        String?
  voice     Int?
  header    String?
  footer    String?
  copies    Int     @default(1)
  autoOnSaleConfirm      Boolean @default(true)
  autoOnPaymentConfirm   Boolean @default(true)
  autoOnDeliveryRegister Boolean @default(false)
  updatedAt DateTime @updatedAt

  @@map("printer_configs")
}

model PrintLog {
  id        String         @id @default(cuid())
  ownerId   String
  sn        String
  kind      String
  relatedId String?
  content   String
  copies    Int            @default(1)
  status    PrintLogStatus @default(pending)
  orderId   String?
  error     String?
  failedAt  DateTime?
  createdAt DateTime       @default(now())

  @@index([ownerId, createdAt])
  @@index([status])
  @@map("print_logs")
}

// ─── AUDIT LOGS ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(cuid())
  action     String  // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  resource   String  // product, order, user, etc.
  resourceId String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── POS TERMINAUX ────────────────────────────────────────────────────────────

model PosTerminal {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name          String
  code          String?
  description   String?
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  isDefault     Boolean  @default(false)

  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // JSON array of allowed payment methods, null = all allowed
  allowedPaymentMethods Json?

  // Optional XPyun printer serial override for this terminal
  printerSn     String?

  // Optional table floor section filter
  tableSection  String?

  assignedUsers  PosTerminalUser[]
  caisseSessions CaisseSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("pos_terminals")
}

model PosTerminalUser {
  terminalId String
  userId     String

  terminal   PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([terminalId, userId])
  @@map("pos_terminal_users")
}

// ─── DETTES CLIENTS ───────────────────────────────────────────────────────────

model CustomerDebt {
  id         String    @id @default(cuid())
  amount     Float     // montant total de la dette
  paidAmount Float     @default(0)
  status     String    @default("PENDING") // PENDING | PARTIAL | PAID | CANCELLED
  dueDate    DateTime?
  notes      String?
  orderRef   String?   // numéro de commande ou référence libre

  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  payments DebtPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([customerId])
  @@index([status])
  @@map("customer_debts")
}

model DebtPayment {
  id     String @id @default(cuid())
  amount Float
  method String @default("CASH")
  notes  String?

  debtId String
  debt   CustomerDebt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([debtId])
  @@map("debt_payments")
}
