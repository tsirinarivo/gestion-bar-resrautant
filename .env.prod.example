# ═══════════════════════════════════════════════════════════════════════════
# .env.prod — Copiez ce fichier en .env.prod et remplissez VOS valeurs
# NE JAMAIS committer .env.prod dans git !
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de données ─────────────────────────────────────────────────────────
POSTGRES_DB=restaurant_db
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_FORT_ICI

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_REDIS_ICI

# ── JWT (générez avec: openssl rand -base64 64) ─────────────────────────────
JWT_SECRET=GENEREZ_UNE_CLE_SECRETE_FORTE_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=GENEREZ_UNE_AUTRE_CLE_SECRETE_64_CHARS_MINIMUM
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs publiques ──────────────────────────────────────────────────────────
# TRANSITION : ancien domaine restaurant.dago-it.com pendant que sakafio.mg
# n'est pas encore acheté/propagé. Bascule en 1 commit dès que sakafio.mg
# est opérationnel (DNS + certbot --expand sakafio.mg).
NEXT_PUBLIC_API_URL=https://api.restaurant.dago-it.com
NEXT_PUBLIC_SOCKET_URL=https://api.restaurant.dago-it.com
# Quand sakafio.mg sera prêt, remplacer ci-dessus par :
# NEXT_PUBLIC_API_URL=https://api.sakafio.mg
# NEXT_PUBLIC_SOCKET_URL=https://api.sakafio.mg

# ── CORS ────────────────────────────────────────────────────────────────────
# On autorise les 2 domaines pendant la transition (sakafio.mg + dago-it.com)
ALLOWED_ORIGINS=https://sakafio.mg,https://admin.sakafio.mg,https://pos.sakafio.mg,https://kds.sakafio.mg,https://master.sakafio.mg,https://restaurant.dago-it.com,https://admin.restaurant.dago-it.com,https://pos.restaurant.dago-it.com,https://kds.restaurant.dago-it.com,https://master.restaurant.dago-it.com

# ── Stripe (optionnel - paiements en ligne) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloudinary (optionnel - upload images) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_application
EMAIL_FROM=noreply@restaurant.dago-it.com
# Quand sakafio.mg sera prêt : EMAIL_FROM=noreply@sakafio.mg

# ── Master Console SaaS (multi-tenant) ──────────────────────────────────────
MASTER_DB_NAME=master_db
MASTER_JWT_SECRET=GENEREZ_UNE_CLE_DEDIEE_AU_MASTER_64_CHARS_MINIMUM

# ── Environnement ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
